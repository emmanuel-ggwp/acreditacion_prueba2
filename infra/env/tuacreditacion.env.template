# infra/env/tuacreditacion.env.template — PLANTILLA del EnvironmentFile.
#
# provision.sh la instala en /etc/tuacreditacion.env SOLO si no existe (los
# secretos ya generados no se pisan), con permisos 600 y propiedad del usuario
# de servicio, sustituyendo @DOMAIN@, @APP_PORT@, @UPLOADS_DIR@ y generando
# @JWT_SECRET@/@JWT_REFRESH_SECRET@ con openssl rand.
#
# EL FICHERO INSTALADO JAMÁS SE VERSIONA NI SE IMPRIME: contiene credenciales
# (R2). La lista canónica de variables y sus porqués: .example.env del repo.

# SIN query string (P07-D7.10): la URL de la consola de DigitalOcean termina en
# "?sslmode=require" — QUÍTALO, el arranque la rechaza si lo trae. Conexión por
# el HOSTNAME PRIVADO de la VPC (I5/I8) y como el USUARIO DE APLICACIÓN (solo
# DML; doadmin es para migraciones y aprovisionamiento, no para servir).
# Contraseña con caracteres especiales: percent-encoded.
DATABASE_URL="CAMBIAME:postgresql://usuario_app:contrasena@host-privado-vpc:25060/basedatos"

# Generados al crear este fichero. Nada del servidor anterior se reutiliza.
JWT_SECRET="@JWT_SECRET@"
JWT_REFRESH_SECRET="@JWT_REFRESH_SECRET@"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

NODE_ENV="production"

# Puerto local de `next start`; el upstream de Nginx apunta aquí. El bind a
# 127.0.0.1 lo fija el ExecStart de la unidad systemd, no este fichero.
PORT="@APP_PORT@"

ALLOWED_ORIGIN="https://@DOMAIN@"

# Ruta persistente FUERA del árbol de despliegue; la aprovisiona
# StateDirectory= + provision.sh, y el arranque prueba una escritura real.
UPLOADS_DIR="@UPLOADS_DIR@"

# La base administrada EXIGE SSL (D0). Con "true", el arranque aborta si la CA
# de abajo no es legible (P07-D7.9 / SB-09).
DB_SSL="true"

# CA del cluster (Standard Edition), descargada de la consola al aprovisionar:
# el runbook (infra/RUNBOOK.md) dice cómo, y cómo apuntar su caducidad.
DB_CA_CERT="/etc/tuacreditacion/ca-certificate.crt"

# Variables DE BUILD (se inlinean en `next build`; cambiarlas exige recompilar
# y redesplegar — P08-D8.1). Se declaran aquí para que el build hecho en el
# droplet (fase 4) las vea al cargar este fichero.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
NEXT_PUBLIC_MODIFY_CONTACT_EMAIL=""
